"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -STA -Command "$ErrorActionPreference='Stop'; try { $root=$env:CAS_PACKAGE_DIR; $journal=Join-Path $root 'update-journal.json'; if(Test-Path -LiteralPath $journal){$record=Get-Content -LiteralPath $journal -Raw -Encoding UTF8|ConvertFrom-Json; $previous=Join-Path $root 'Previous-Version'; foreach($name in @('Start-One-Click.cmd','Start-Market-Watch.cmd','Start-Server.ps1','Update-Manager.ps1','app.html','README.txt')){$file=Join-Path $previous $name; if($record.previousFiles.$name -cnotmatch '^[0-9a-f]{64}$' -or (Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash.ToLowerInvariant() -cne $record.previousFiles.$name){throw 'Previous version verification failed. Extract a fresh ZIP.'}}; & (Join-Path $previous 'Update-Manager.ps1') -Action ApplyPending -InstallRoot $root; if(Test-Path -LiteralPath $journal){throw 'Could not restore previous version.'}; Start-Process -FilePath (Join-Path $root 'Start-One-Click.cmd'); exit 0}; $files=@{'Start-Server.ps1'='42B1A7150B8B7FA18666E35395C5C046D4C2B916B353DF067DEF99319AE11E39'; 'Update-Manager.ps1'='C0BB058CE7293EFDD1C078D9D67F124B23D6249EF26B718A647D05DF84E924F9'; 'app.html'='2904B59C10BB7629113278DF1F8295370BCF781CA7F780F87646457091637705'}; foreach($name in $files.Keys){ $file=Join-Path $root $name; if(-not (Test-Path -LiteralPath $file -PathType Leaf)){throw ('Missing '+$name+'. Extract the entire ZIP into one folder.')}; if((Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash -cne $files[$name]){throw ('Package verification failed for '+$name+'. Extract a fresh copy of this ZIP.')} }; $machine=Get-ExecutionPolicy -Scope MachinePolicy; $user=Get-ExecutionPolicy -Scope UserPolicy; $effective=Get-ExecutionPolicy; $managed=($machine -ne 'Undefined' -or $user -ne 'Undefined'); $server=Join-Path $root 'Start-Server.ps1'; if($effective -eq 'AllSigned'){throw 'PowerShell requires signed scripts (AllSigned). This release is unsigned.'}; if($managed -and $effective -eq 'Restricted'){throw 'Group Policy has disabled PowerShell scripts (Restricted).'}; if(-not $managed){ Set-ExecutionPolicy -Scope Process -ExecutionPolicy RemoteSigned -Force; if((Get-ExecutionPolicy) -ne 'RemoteSigned'){throw 'The requested PowerShell session policy did not take effect.'}; if(Get-Item -LiteralPath $server -Stream 'Zone.Identifier' -ErrorAction SilentlyContinue){Unblock-File -LiteralPath $server} }; & (Join-Path $root 'Update-Manager.ps1') -Action ApplyPending -InstallRoot $root; & $server; exit 0 } catch { [Console]::Error.WriteLine($_.Exception.Message); exit 1 }"
